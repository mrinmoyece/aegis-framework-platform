{
  "name": "@aegis/operator-workspace",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.0.0 <27",
    "npm": "11.12.1"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:axe": "vitest run src/accessibility.test.tsx",
    "build": "tsc --noEmit && vite build",
    "e2e": "playwright test",
    "contracts": "node tools/check-contracts.mjs",
    "audit": "npm audit --audit-level=high --omit=dev",
    "licenses": "license-checker-rseidelsohn --production --onlyAllow 'Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;MIT;MPL-2.0;Unlicense;CC-BY-4.0;CC0-1.0' --excludePrivatePackages",
    "bundle": "node tools/check-bundle.mjs",
    "csp": "node tools/check-csp.mjs",
    "ci": "npm run lint && npm run typecheck && npm run contracts && npm run test && npm run test:axe && npm run build && npm run bundle && npm run csp && npm run licenses && npm run audit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-table": "8.21.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.10.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "license-checker-rseidelsohn": "5.0.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
